PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_hub

# MongoDB
MONGO_URI=mongodb://mongo_user:mongo_pass123@localhost:27017/knowledge_hub?authSource=admin
MONGO_DB=knowledge_hub

# Snowflake (worker 0-1023)
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_OFFSET=1704067200000

# RustFS (S3 compatible)
RUSTFS_ENABLED=true
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_PUBLIC_URL=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=knowledge-hub
RUSTFS_REGION=us-east-1

# RabbitMQ
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# RAG chunking
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# Embedding (OpenAI compatible)
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BATCH_SIZE=10
# EMBEDDING_API_KEY=
# DASHSCOPE_API_KEY=

# Hybrid retrieval
RAG_HYBRID_TOP_K=20
RAG_RRF_C=60
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=qwen3-rerank
RAG_MIN_SCORE=0.4
# RERANK_API_KEY=
# RERANK_BASE_URL=https://dashscope.aliyuncs.com

# LLM
KG_LLM_TIMEOUT_MS=120000
AI_CHAT_TIMEOUT_MS=60000
AI_QUERY_REWRITE_TIMEOUT_MS=15000
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
# LLM_ENABLE_THINKING=true

# Web search (Bocha)
# BOCHA_API_KEY=

# Elasticsearch
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_NODE=http://localhost:9200

# Neo4j
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# JWT
JWT_SECRET=dev-secret-change-me-in-production
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# Email verification
REQUIRE_EMAIL_VERIFICATION=false
APP_PUBLIC_URL=http://localhost:3000

# SMTP
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=xx@xx.com
MAIL_PASS=xx
MAIL_FROM="Knowledge Hub <xx@xx.com>"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Chat memory
CHAT_SHORT_MEMORY_TTL_SECONDS=86400
CHAT_SHORT_MEMORY_MAX_MESSAGES=20
# CHAT_SHORT_MEMORY_KEY_PREFIX=kh:chat

# Long memory (Mem0)
# MEM0_API_KEY=
# MEM0_HOST=https://api.mem0.ai
MEM0_TOP_K=5

# Document review
DOCUMENT_REQUIRE_APPROVAL=true
